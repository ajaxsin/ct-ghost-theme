                        {{else match type "tiktok"}}<i class="fa-brands fa-tiktok"></i>
                        {{else match type "bluesky"}}<i class="fa-brands fa-bluesky"></i>
                        {{else match type "mastodon"}}<i class="fa-brands fa-mastodon"></i>
                        {{else}}<i class="fa-solid fa-link"></i>{{/match}}
                    </a>
                {{else}}
                    {{#unless @custom.pinterest_url}}
                        {{!-- Fallback links when no social accounts configured in Ghost yet --}}
                        <a href="https://instagram.com" class="social-link" target="_blank" rel="noopener" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
