                        {{else match type "instagram"}}<i class="fa-brands fa-instagram"></i>
                        {{else match type "youtube"}}<i class="fa-brands fa-youtube"></i>
                        {{else match type "linkedin"}}<i class="fa-brands fa-linkedin-in"></i>
