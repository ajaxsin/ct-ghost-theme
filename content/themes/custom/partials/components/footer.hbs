{{!-- Crafttatva Design Footer --}}
<footer class="footer">

    {{!-- Section 1: Top Newsletter, Brand & Trustpilot --}}
    <div class="footer-section section-top">
        <div class="container container-top">
            
            {{!-- Brand Col --}}
            <div class="div-brand">
                <a href="{{@site.url}}" class="link-crafttatva" aria-label="{{@site.title}}">
                    {{#if @site.logo}}
                        <img class="crafttatva-logo-img" src="{{@site.logo}}" alt="{{@site.title}}">
                    {{else}}
                        <img class="crafttatva-logo-img" src="{{asset "images/footer/crafttatva-logo.png"}}" alt="{{@site.title}}">
                    {{/if}}
                </a>
                <div class="text-wrapper-brand">
                    <p class="text-brand">
                        {{#if @site.description}}
                            {{@site.description}}
                        {{else}}
                            Discover and collect original<br/>art from independent Indian<br/>artists.
                        {{/if}}
                    </p>
                </div>
                <div class="social-links">
                    {{#social_accounts @site}}
                        <a href="{{href}}" class="social-link" target="_blank" rel="noopener" aria-label="{{name}}">
                            {{#match type "facebook"}}<i class="fa-brands fa-facebook-f"></i>
                            {{else match type "instagram"}}<i class="fa-brands fa-instagram"></i>
                            {{else match type "youtube"}}<i class="fa-brands fa-youtube"></i>
                            {{else match type "linkedin"}}<i class="fa-brands fa-linkedin-in"></i>
                            {{else match type "x"}}<i class="fa-brands fa-x-twitter"></i>
                            {{else match type "threads"}}<i class="fa-brands fa-threads"></i>
                            {{else match type "tiktok"}}<i class="fa-brands fa-tiktok"></i>
                            {{else match type "bluesky"}}<i class="fa-brands fa-bluesky"></i>
                            {{else match type "mastodon"}}<i class="fa-brands fa-mastodon"></i>
                            {{else}}<i class="fa-solid fa-link"></i>{{/match}}
                        </a>
                    {{else}}
                        {{#unless @custom.pinterest_url}}
                            <a href="https://instagram.com" class="social-link" target="_blank" rel="noopener" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                            <a href="https://facebook.com" class="social-link" target="_blank" rel="noopener" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                            <a href="https://pinterest.com" class="social-link" target="_blank" rel="noopener" aria-label="Pinterest"><i class="fa-brands fa-pinterest-p"></i></a>
                            <a href="https://youtube.com" class="social-link" target="_blank" rel="noopener" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
                            <a href="https://linkedin.com" class="social-link" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
                        {{/unless}}
                    {{/social_accounts}}
                    {{#if @custom.pinterest_url}}
                        <a href="{{@custom.pinterest_url}}" class="social-link" target="_blank" rel="noopener" aria-label="Pinterest">
                            <i class="fa-brands fa-pinterest-p"></i>
                        </a>
                    {{/if}}
                </div>
            </div>

            {{!-- Newsletter Col --}}
            <div class="container-newsletter">
                <div class="heading-stay">
                    {{#if @custom.signup_heading}}{{@custom.signup_heading}}{{else}}Stay Inspired{{/if}}
                </div>
                <div class="newsletter-sub-wrapper">
                    <div class="div-newsletter-desc">
                        <p class="text-newsletter-desc">
                            {{#if @custom.signup_subheading}}{{@custom.signup_subheading}}{{else}}Get new artwork, artist stories, curated collections and<br/>exclusive updates.{{/if}}
                        </p>
                    </div>
                </div>
                <div class="form-margin">
                    <form class="footer-form" data-members-form="subscribe">
                        <div class="footer-input-wrap">
                            <input class="footer-input" placeholder="Email Address" type="email" required data-members-email />
                        </div>
                        <button class="footer-button" type="submit">
                            <span class="text-btn subscribe-state-default">SUBSCRIBE</span>
                            <span class="text-btn subscribe-state-loading">{{t "Sending..."}}</span>
                            <span class="text-btn subscribe-state-success">{{t "Subscribed!"}}</span>
                        </button>
                    </form>
                    <p data-members-error class="subscribe-error"></p>
                </div>
                <div class="container-privacy">
                    <div class="div-privacy">
                        <p class="text-privacy">By subscribing, you agree to our <a href="{{@site.url}}/privacy/" class="privacy-link">Privacy Policy</a>.</p>
                    </div>
                </div>
            </div>

            {{!-- Trustpilot Col --}}
            <div class="link-trustpilot">
                <a href="https://www.trustpilot.com/review/crafttatva.com" target="_blank" rel="noopener" class="tp-widget-inner">
                    <div class="container-tp-header">
                        <div class="container-tp-brand">
                            <div class="SVG-tp-star">
                                <svg class="vector-tp-star" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="#00b67a"/>
                                </svg>
                            </div>
                            <div class="tp-brand-name">
                                <span class="text-tp">Trustpilot</span>
                            </div>
                        </div>
                        <div class="tp-stars-row">
                            <span class="tp-star-box"><i class="fa-solid fa-star"></i></span>
                            <span class="tp-star-box"><i class="fa-solid fa-star"></i></span>
                            <span class="tp-star-box"><i class="fa-solid fa-star"></i></span>
                            <span class="tp-star-box"><i class="fa-solid fa-star"></i></span>
                            <span class="tp-star-box"><i class="fa-solid fa-star"></i></span>
                        </div>
                    </div>
                    <div class="tp-score-text">
                        <p class="text-tp-score">
                            <span class="span-score">TrustScore 4.8 | </span>
                            <span class="span-reviews">78 reviews</span>
                        </p>
                    </div>
                </a>
            </div>

        </div>
    </div>

