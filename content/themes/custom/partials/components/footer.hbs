                    <button type="submit" class="subscribe-button">
                        <span class="subscribe-state-default">{{t "Subscribe"}}</span>
                        <span class="subscribe-state-loading">{{t "Sending..."}}</span>
                        <span class="subscribe-state-success">{{t "Subscribed!"}}</span>
                    </button>
